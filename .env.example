# Contoh variabel lingkungan untuk Railway
# Salin ke .env (lokal) atau tambahkan di Railway Dashboard > Variables

# Node.js
NODE_ENV=production
PORT=3000

# WhatsApp session sudah disertakan di folder ./sessions (sudah terpairing).
# Jangan menambahkan nomor atau pairing code di sini — bot akan connect otomatis
# menggunakan sesi yang ada.

# Catatan: FURINA V18 menggunakan banyak API key internal di settings.js
# (Gemini, Supabase, OTP, dll). Jika ingin mengganti, ubah di settings.js.
